{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)\\.apk",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "https://apna-college-bihar-6.onrender.com/api/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
