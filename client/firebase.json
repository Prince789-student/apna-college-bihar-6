{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.apk",
      "**/*.exe"
    ],
    "redirects": [
      {
        "source": "/ACB_v22_Final.apk",
        "destination": "/ApnaCollegeBihar_Stable.apk",
        "type": 302
      },
      {
        "source": "/ApnaCollegeBihar_v2.2_Pro.apk",
        "destination": "/ApnaCollegeBihar_Stable.apk",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "**/*.apk",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/vnd.android.package-archive"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "!**/*.apk",
        "destination": "/index.html"
      }
    ]
  }
}
