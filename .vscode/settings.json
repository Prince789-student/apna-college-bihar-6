{
    "java.project.referencedLibraries": [
        "lib/**/*.jar"
    ],
    "java.configuration.runtimes": [],
    "java.autobuild.enabled": false,
    "java.import.exclusions": [
        "**/node_modules/**",
        "**/.git/**"
    ],
    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true,
        "**/node_modules": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/dist": true
    },
    "java.configuration.updateBuildConfiguration": "interactive"
}