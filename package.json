{
  "name": "apna-college-bihar",
  "version": "1.0.0",
  "description": "Full stack application ready for Render deployment",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server/server.js",
    "postinstall": "npm install --prefix server",
    "install-app": "npm install --prefix server && npm install --prefix client",
    "build": "npm install --prefix server",
    "heroku-postbuild": "npm run build",
    "dev": "npm run dev --prefix client",
    "electron:dev": "electron .",
    "electron:build": "npm run build --prefix client && electron-builder",
    "electron:package": "npm run build --prefix client && electron-packager . \"Apna College Bihar\" --platform=win32 --arch=x64 --out=dist-electron --overwrite",
    "save": "git add . && git commit -m \"auto commit\" && git push"
  },
  "build": {
    "appId": "com.apnacollegebihar.app",
    "productName": "Apna College Bihar",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron-main.js",
      "client/dist/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "client/public/logo-acb.png",
      "forceCodeSigning": false
    }
  },
  "engines": {
    "node": "20.x"
  },
  "devDependencies": {
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2"
  }
}
