{
  "name": "apna-college-bihar-desktop",
  "productName": "Apna College Bihar",
  "version": "2.2.0",
  "description": "Apna College Bihar - Official Laptop & Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "node build-app.js",
    "pack:linux": "electron-packager . \"Apna-College-Bihar\" --platform=linux --arch=x64 --out=dist --overwrite",
    "build:linux": "node build-linux.js",
    "build:mac": "python build-mac.py",
    "build:installer": "npx electron-builder --win nsis --x64"
  },
  "author": "Apna College Bihar",
  "license": "MIT",
  "build": {
    "appId": "com.apnacollegebihar.desktop",
    "productName": "Apna College Bihar",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "artifactName": "Apna-College-Bihar-Setup.exe"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.0.0"
  }
}