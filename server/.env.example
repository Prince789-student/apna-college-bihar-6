# ==========================================
# Apna College Bihar Server Environment Template
# Duplicate this file to .env and provide your secrets
# DO NOT commit .env to version control!
# ==========================================

# Server Network Configuration
PORT=5000
NODE_ENV=production
APP_URL=https://apnacollegebihar.online

# Database & Authentication
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
JWT_SECRET=your_super_strong_random_jwt_secret_minimum_32_characters_here
JWT_EXPIRES_IN=30d

# Email SMTP Notification Service
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password_16_digits

# AI Services & Scrapers
GEMINI_API_KEY=your_google_gemini_api_key

# Telegram / WhatsApp Alerts (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/example

# Firebase Admin Service Account (Base64 encoded string or JSON file path)
# FIREBASE_SERVICE_ACCOUNT=ey...

# Rate Limiting & Account Exponential Backoff Configuration (Optional - Defaults Provided)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=15
AUTH_ACCOUNT_MAX_ATTEMPTS=5
AUTH_BACKOFF_BASE_SECONDS=60
AUTH_BACKOFF_MAX_SECONDS=1800
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=120
AUTHED_RATE_LIMIT_WINDOW_MS=900000
AUTHED_RATE_LIMIT_MAX=300
