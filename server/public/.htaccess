<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # 0. Explicit APK download route bypass
  RewriteRule ^api/download-apk$ ApnaCollegeBihar_v2.2_Pro.apk [L]
  RewriteRule ^ACB_v22_Final\.apk$ ApnaCollegeBihar_v2.2_Pro.apk [L]
  
  # 1. Force Download for APK and ZIP files
  RewriteRule ^(.*\.(apk|zip))$ - [L]
  
  # 2. SPA Routing: If the file or directory exists, serve it
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  
  # 3. Otherwise, serve index.html
  RewriteRule ^ index.html [L]
</IfModule>
