rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is an Admin
    function isAdmin() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN'
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated(); // Needed for admin panel to see all users
      allow write: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
    }
    
    // Main Documents (Notes & PYQs)
    match /documents/{docId} {
      allow read: if true; 
      allow write: if isAdmin();
    }
    
    // Announcements
    match /announcements/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Ads
    match /ads/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Study Resources
    match /studyResources/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Groups
    match /groups/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Study Dashboard specific collections
    match /Subjects/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /Tasks/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /StudySessions/{docId} {
      allow read, write: if isAuthenticated();
    }

    // BEU Notifications
    match /beu_notifications/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Hackathons
    match /hackathons/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny for anything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
