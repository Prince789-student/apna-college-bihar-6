!server/public/Apna-College-Bihar-macOS.zip
!server/public/Apna-College-Bihar-macOS-Intel.zip

# EXCEPTIONS: Allow committing APK/AAB and Windows Setup files in the client public folder for Vercel/Netlify hosting
!client/public/*.apk
!client/public/**/*.apk
!client/public/*.aab
!client/public/**/*.aab
!client/public/Apna-College-Bihar-Setup.exe
