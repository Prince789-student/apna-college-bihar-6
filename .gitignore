# Dependencies
node_modules/

# Local Netlify and Firebase folders
.netlify/
.firebase/
firebase-debug.log*

# IDE/Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment variables
.env
.env.*
*firebase-service-account*.json

# Build output directories
dist/
build/
dist-electron/
electron-workspace/
out/

# Android build outputs inside client
client/android/app/build/
client/android/.gradle/
client/android/local.properties

# System Files
.DS_Store
Thumbs.db

# Temporary/Backup files
old.jsx
old2.jsx
diff.txt
diff2.txt
log.txt
upload_res.json

# Ignore all APKs, AABs, PDFs, and ZIPs by default to prevent repository bloat
*.apk
*.aab
*.pdf
*.zip
*.exe

# EXCEPTIONS: Allow committing hosting assets in the server folder so they deploy to Render
!server/**/*.apk
!server/**/*.aab
!server/**/*.pdf
!server/**/*.zip

# EXCEPTIONS: Allow committing APK/AAB files in the client public folder for Netlify hosting
!client/public/**/*.apk
!client/public/**/*.aab